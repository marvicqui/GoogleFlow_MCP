# Required (Gemini API): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: use Vertex AI instead of the Gemini API
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: where videos/images are saved (default: ./flow-output)
# FLOW_OUTPUT_DIR=C:\Users\me\Videos\flow

# Optional: override default models
# FLOW_VIDEO_MODEL=veo-3.1-generate-preview
# FLOW_VIDEO_FAST_MODEL=veo-3.1-fast-generate-preview
# FLOW_IMAGE_MODEL=gemini-3-pro-image-preview
