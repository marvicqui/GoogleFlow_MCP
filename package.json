{
  "name": "googleflow-mcp",
  "version": "0.1.0",
  "description": "MCP server to create videos and images with the Google Flow models (Veo 3.1, Nano Banana) from Claude Code and Codex using natural language.",
  "type": "module",
  "bin": {
    "googleflow-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "google-flow",
    "veo",
    "nano-banana",
    "gemini",
    "claude-code",
    "codex"
  ],
  "author": "marvicqui",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
